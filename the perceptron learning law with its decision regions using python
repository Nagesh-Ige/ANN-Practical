import numpy as np
import matplotlib.pyplot as plt

x = np.array([
    [2, 3],
    [1, 5],
    [2, 8],
    [5, 2],
    [6, 1],
    [7, 3]
])

y = np.array([0, 0, 0, 1, 1, 1])

w = np.zeros(2)
b = 0
lr = 0.1

for epoch in range(20):
    for i in range(len(x)):
        net = np.dot(x[i], w) + b
        output = 1 if net >= 0 else 0
        error = y[i] - output

        w = w + lr * error * x[i]
        b = b + lr * error

x1_min = x[:, 0].min() - 1
x1_max = x[:, 0].max() + 1

x1 = np.linspace(x1_min, x1_max, 100)

x2 = -(w[0] * x1 + b) / w[1]

for i in range(len(x)):
    if y[i] == 0:
        plt.scatter(x[i][0], x[i][1], marker='o', label='Class 0' if i == 0 else "")
    else:
        plt.scatter(x[i][0], x[i][1], marker='s', label='Class 1' if i == 3 else "")

plt.plot(x1, x2, label='Decision Boundary')

plt.xlabel('X1')
plt.ylabel('X2')
plt.title('Perceptron Learning Decision Region')
plt.legend()
plt.grid(True)

plt.show()
